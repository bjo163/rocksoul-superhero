{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rocksoul.dev/superhero/schemas/evidence.schema.json",
  "title": "SUPERHERO Evidence Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim_id",
    "relation",
    "evidence_type",
    "summary",
    "source_refs",
    "confidence",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVD-PER-[A-Z0-9][A-Z0-9-]*$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-PER-[A-Z0-9][A-Z0-9-]*$"
    },
    "relation": {
      "enum": [
        "supports",
        "contradicts",
        "contextualizes",
        "alternative_explanation",
        "unresolved_uncertainty"
      ]
    },
    "evidence_type": {
      "enum": [
        "textual",
        "archival",
        "biographical",
        "documentary",
        "epigraphic",
        "manuscript",
        "institutional",
        "scholarly_interpretation",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(mftl|legend|superhero):[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
