{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rocksoul.dev/superhero/schemas/source.schema.json",
  "title": "SUPERHERO Local Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source_type",
    "creator",
    "date",
    "locator",
    "provenance",
    "quality",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRC-SH-[A-Z0-9][A-Z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "primary_document",
        "archival_record",
        "manuscript",
        "scholarly_work",
        "institutional",
        "museum",
        "library",
        "other"
      ]
    },
    "creator": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "enum": [
        "primary",
        "high",
        "medium",
        "discovery_only",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
