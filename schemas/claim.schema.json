{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rocksoul.dev/superhero/schemas/claim.schema.json",
  "title": "SUPERHERO Atomic Person Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject_id",
    "statement",
    "claim_type",
    "epistemic_status",
    "source_refs",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLM-PER-[A-Z0-9][A-Z0-9-]*$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9][A-Z0-9-]*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "identity",
        "chronology",
        "authorship",
        "witnessing",
        "participation",
        "transmission",
        "interpretation",
        "attribution",
        "other"
      ]
    },
    "epistemic_status": {
      "enum": [
        "supported_as_documentary_attestation",
        "strongly_supported",
        "probable",
        "plausible",
        "disputed",
        "unverified",
        "contradicted",
        "indeterminate"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(mftl|legend|superhero):[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
